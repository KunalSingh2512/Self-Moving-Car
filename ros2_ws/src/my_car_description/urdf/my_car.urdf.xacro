<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_car">

    <xacro:property name="wheel_offset_y" value="0.18"/> 
    <xacro:property name="wheel_offset_x" value="0.25"/>
    <xacro:property name="wheel_radius" value="0.06"/>
    <xacro:property name="wheel_width" value="0.04"/>
    <xacro:property name="wheel_drop" value="0.05"/> 

    <xacro:property name="base_width" value="0.25"/>
    <xacro:property name="base_length" value="0.69"/>
    <xacro:property name="base_thickness" value="0.02"/>

    <xacro:property name="stack_length" value="0.30"/> 
    <xacro:property name="stack_width" value="0.20"/>
    <xacro:property name="level_1_height" value="0.12"/>
    <xacro:property name="level_2_height" value="0.12"/>
    <xacro:property name="platform_thickness" value="0.01"/>

    <xacro:property name="ramp_length" value="0.20"/>
    <xacro:property name="ramp_rise" value="${level_1_height}"/>
    <xacro:property name="ramp_run" value="${sqrt(ramp_length*ramp_length - ramp_rise*ramp_rise)}"/>
    <xacro:property name="ramp_angle" value="${atan2(ramp_rise, ramp_run)}"/>

    <material name="white"><color rgba="1 1 1 0.8"/></material>
    <material name="orange"><color rgba="1 0.3 0.1 1"/></material>
    <material name="blue"><color rgba="0.2 0.2 1 1"/></material>
    <material name="black"><color rgba="0 0 0 1"/></material>
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    <material name="metal"><color rgba="0.8 0.8 0.8 1"/></material>
    <material name="red"><color rgba="1 0 0 1"/></material>
    <material name="purple"><color rgba="1 0 1 1"/></material>
    <material name="yellow"><color rgba="1 1 0 1"/></material>

    <xacro:macro name="box_inertia" params="m l w h">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (h*h + l*l)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + l*l)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy = "0" ixz = "0" iyy="${(m/12) * (3*r*r + h*h)}" iyz = "0" izz="${(m/2) * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <link name="base_link"></link>

    <joint name="supreme_base_joint" type="fixed">
        <parent link="base_link"/>
        <child link="supreme_base"/>
        <origin xyz="0 0 ${wheel_radius + wheel_drop}"/> 
    </joint>
    
    <link name="supreme_base">
        <visual><geometry><box size="${base_length} ${base_width} ${base_thickness}"/></geometry><material name="metal"/></visual>
        <collision><geometry><box size="${base_length} ${base_width} ${base_thickness}"/></geometry></collision>
        <xacro:box_inertia m="2.0" l="${base_length}" w="${base_width}" h="${base_thickness}"/>
    </link>

    <joint name="level_1_joint" type="fixed">
        <parent link="supreme_base"/>
        <child link="level_1"/>
        <origin xyz="0 0 ${base_thickness/2 + level_1_height/2}"/>
    </joint>
    <link name="level_1">
        <visual><geometry><box size="${stack_length} ${stack_width} ${level_1_height}"/></geometry><material name="metal"/></visual>
        <collision><geometry><box size="${stack_length} ${stack_width} ${level_1_height}"/></geometry></collision>
        <xacro:box_inertia m="2.0" l="${stack_length}" w="${stack_width}" h="${level_1_height}"/>
    </link>

    <joint name="front_ramp_joint" type="fixed">
        <parent link="supreme_base"/>
        <child link="front_ramp"/>
        <origin xyz="${stack_length/2 + ramp_run/2} 0 ${base_thickness/2 + ramp_rise/2}" rpy="0 ${ramp_angle} 0"/>
    </joint>
    <link name="front_ramp">
        <visual><geometry><box size="${ramp_length} ${stack_width} 0.02"/></geometry><material name="metal"/></visual>
        <collision><geometry><box size="${ramp_length} ${stack_width} 0.02"/></geometry></collision>
    </link>

    <joint name="rear_ramp_joint" type="fixed">
        <parent link="supreme_base"/>
        <child link="rear_ramp"/>
        <origin xyz="-${stack_length/2 + ramp_run/2} 0 ${base_thickness/2 + ramp_rise/2}" rpy="0 -${ramp_angle} 0"/>
    </joint>
    <link name="rear_ramp">
        <visual><geometry><box size="${ramp_length} ${stack_width} 0.02"/></geometry><material name="metal"/></visual>
        <collision><geometry><box size="${ramp_length} ${stack_width} 0.02"/></geometry></collision>
    </link>

    <joint name="platform1_joint" type="fixed">
        <parent link="level_1"/>
        <child link="platform_1"/>
        <origin xyz="0 0 ${level_1_height/2 + platform_thickness/2}"/>
    </joint>
    <link name="platform_1">
        <visual><geometry><box size="${stack_length} ${stack_width} ${platform_thickness}"/></geometry><material name="orange"/></visual>
    </link>

    <joint name="level_2_joint" type="fixed">
        <parent link="platform_1"/>
        <child link="level_2"/>
        <origin xyz="0 0 ${platform_thickness/2 + level_2_height/2}"/>
    </joint>
    <link name="level_2">
        <visual><geometry><box size="${stack_length} ${stack_width} ${level_2_height}"/></geometry><material name="metal"/></visual>
        <collision><geometry><box size="${stack_length} ${stack_width} ${level_2_height}"/></geometry></collision>
        <xacro:box_inertia m="1.0" l="${stack_length}" w="${stack_width}" h="${level_2_height}"/>
    </link>

    <joint name="roof_joint" type="fixed">
        <parent link="level_2"/>
        <child link="roof"/>
        <origin xyz="0 0 ${level_2_height/2 + platform_thickness/2}"/>
    </joint>
    <link name="roof">
        <visual><geometry><box size="${stack_length} ${stack_width} ${platform_thickness}"/></geometry><material name="orange"/></visual>
    </link>

    <xacro:macro name="rear_wheel" params="name x y">
        <link name="${name}_wheel">
            <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
            <collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
            <xacro:cylinder_inertia m="2.0" r="${wheel_radius}" h="${wheel_width}"/>
        </link>
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="supreme_base"/>
            <child link="${name}_wheel"/>
            <origin xyz="${x} ${y} -${wheel_drop}" rpy="-${pi/2} 0 0"/> 
            <axis xyz="0 0 1"/>
            <dynamics damping="0.5" friction="0.2"/> 
        </joint>
    </xacro:macro>
    <xacro:rear_wheel name="left_rear"   x="-${wheel_offset_x}" y="${wheel_offset_y}"/>
    <xacro:rear_wheel name="right_rear"  x="-${wheel_offset_x}" y="-${wheel_offset_y}"/>

    <xacro:macro name="front_wheel" params="name x y">
        <link name="${name}_wheel">
            <visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
            <collision><geometry><sphere radius="${wheel_radius}"/></geometry></collision>
            <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
        </link>
        <joint name="${name}_wheel_joint" type="continuous">
            <parent link="supreme_base"/>
            <child link="${name}_wheel"/>
            <origin xyz="${x} ${y} -${wheel_drop}" rpy="-${pi/2} 0 0"/> 
            <axis xyz="0 0 1"/>
            <dynamics damping="0.5" friction="0.2"/> 
        </joint>
    </xacro:macro>
    <xacro:front_wheel name="left_front"  x="${wheel_offset_x}"  y="${wheel_offset_y}"/>
    <xacro:front_wheel name="right_front" x="${wheel_offset_x}"  y="-${wheel_offset_y}"/>

    <joint name="lidar_joint" type="fixed">
        <parent link="roof"/>
        <child link="laser_frame"/>
        <origin xyz="0 0 0.025" rpy="0 0 0"/> 
    </joint>
    <link name="laser_frame">
        <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry><material name="blue"/></visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="roof"/>
        <child link="camera_link"/>
        <origin xyz="${stack_length/2 + 0.01} 0 0.015" rpy="0 0 0"/> 
    </joint>
    <link name="camera_link">
        <visual><geometry><box size="0.02 0.04 0.02"/></geometry><material name="red"/></visual>
    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="level_2"/>
        <child link="imu_link"/>
        <origin xyz="0 0 -0.034"/> 
    </joint>
    <link name="imu_link">
        <visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="purple"/></visual>
    </link>

    <joint name="gnss_joint" type="fixed">
        <parent link="roof"/>
        <child link="gnss_link"/>
        <origin xyz="-0.12 0 0.015" rpy="0 0 0"/> 
    </joint>
    <link name="gnss_link">
        <visual><geometry><cylinder radius="0.02" length="0.02"/></geometry><material name="yellow"/></visual>
    </link>

    <gazebo>
        <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
            <left_joint>left_rear_wheel_joint</left_joint>
            <right_joint>right_rear_wheel_joint</right_joint>
            <wheel_separation>${2 * wheel_offset_y}</wheel_separation>
            <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
            <max_wheel_torque>500</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>false</publish_wheel_tf>
        </plugin>
        
        <plugin name="gazebo_ros_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <update_rate>50</update_rate>
            <joint_name>left_front_wheel_joint</joint_name>
            <joint_name>right_front_wheel_joint</joint_name>
            <joint_name>left_rear_wheel_joint</joint_name>
            <joint_name>right_rear_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo reference="laser_frame">
        <sensor name="lidar" type="gpu_ray">
            <always_on>true</always_on>
            <visualize>false</visualize> <update_rate>20.0</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>90</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.349066</min_angle> <max_angle>0.349066</max_angle>  </vertical>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=/scan</remapping>
                </ros>
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>laser_frame</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <visualize>true</visualize>
            <update_rate>30.0</update_rate>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image><format>R8G8B8</format><width>320</width><height>240</height></image>
                <clip><near>0.05</near><far>8.0</far></clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <frame_name>camera_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="imu_link">
        <gravity>true</gravity>
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>__default_topic__</topic>
            <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
                <topicName>imu</topicName>
                <bodyName>imu_link</bodyName>
                <updateRateHZ>20.0</updateRateHZ>
                <gaussianNoise>0.0</gaussianNoise>
                <xyzOffset>0 0 0</xyzOffset>
                <rpyOffset>0 0 0</rpyOffset>
                <frameName>imu_link</frameName>
                <initialOrientationAsReference>false</initialOrientationAsReference>
                <ros>
                    <remapping>~/out:=/imu</remapping>
                </ros>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="gnss_link">
        <sensor name="gnss_sensor" type="gps">
            <always_on>true</always_on>
            <update_rate>5.0</update_rate>
            <plugin name="gnss_controller" filename="libgazebo_ros_gps_sensor.so">
                <ros>
                    <remapping>~/out:=/gnss/fix</remapping>
                </ros>
                <output_type>sensor_msgs/NavSatFix</output_type>
                <frame_name>gnss_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="supreme_base"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="front_ramp"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="rear_ramp"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="level_1"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="level_2"><material>Gazebo/Grey</material></gazebo>
    <gazebo reference="platform_1"><material>Gazebo/Orange</material></gazebo>
    <gazebo reference="roof"><material>Gazebo/Orange</material></gazebo>
    
    <gazebo reference="laser_frame"><material>Gazebo/Blue</material></gazebo>
    <gazebo reference="camera_link"><material>Gazebo/Red</material></gazebo>
    <gazebo reference="imu_link"><material>Gazebo/Purple</material></gazebo>
    <gazebo reference="gnss_link"><material>Gazebo/Yellow</material></gazebo>

    <gazebo reference="left_rear_wheel">
        <material>Gazebo/FlatBlack</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
    </gazebo>
    <gazebo reference="right_rear_wheel">
        <material>Gazebo/FlatBlack</material>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
    </gazebo>
    <gazebo reference="left_front_wheel">
        <material>Gazebo/FlatBlack</material>
        <mu1>0.01</mu1> <mu2>0.01</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
    </gazebo>

    <gazebo reference="right_front_wheel">
        <material>Gazebo/FlatBlack</material>
        <mu1>0.01</mu1> <mu2>0.01</mu2>
        <kp>1000000.0</kp>
        <kd>100.0</kd>
    </gazebo>

</robot>